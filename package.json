{
  "name": "palyaterkep",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "esco": "node src/esco/ingest.ts",
    "branches:review": "node src/branches/review.ts",
    "propose": "node src/vault/propose.ts",
    "vault": "node src/vault/generate.ts",
    "vault:lint": "node src/vault/lint.ts",
    "test": "vitest run",
    "types": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "web:dev": "pnpm --filter palyaterkep-web dev",
    "web:build": "pnpm --filter palyaterkep-web build",
    "web:start": "pnpm --filter palyaterkep-web start",
    "web:check": "pnpm --filter palyaterkep-web check",
    "check": "pnpm format:check && pnpm types && pnpm test && pnpm vault:lint && pnpm web:check"
  },
  "devDependencies": {
    "@types/node": "24.13.5",
    "prettier": "3.9.8",
    "prettier-plugin-svelte": "4.1.1",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "yaml": "2.9.1",
    "zod": "4.6.5"
  }
}
